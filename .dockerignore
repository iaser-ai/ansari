# Keep Docker build contexts small: both service Dockerfiles use the repo
# root as context (the pnpm workspace needs the root lockfile), so anything
# not excluded here uploads on every build.
.git
**/node_modules
**/.next
**/.turbo
**/dist
**/.expo
**/coverage
.builders
**/.DS_Store
**/.env
**/.env.local
**/.env.*.local
apps/frontend/google-service-account
