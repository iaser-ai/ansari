# Copy to bdd/.env and fill in. bdd/ is ignored by git (.git/info/exclude), so
# nothing here is ever committed.

# --- Where the API under test lives (default: this checkout's apps/api) ---
# API_DIR=../apps/api
# Node used to run the API server (the repo pins Node 22 in .nvmrc). Defaults to
# the Node running the tests.
# API_NODE=/path/to/node22

# --- Local database (created for these tests; never ansari_local) ---
# Defaults to postgresql://<your user>@localhost:5432/ansari_bdd
DATABASE_URL=

# --- Real Gemini: fill ONE of the two ---
# Vertex (what production uses):
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
# ...or the public Gemini API:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Real Inkling (Tinker) ---
TINKER_API_KEY=

# --- Islamic tools the answers use ---
KALEMAT_API_KEY=
USUL_API_TOKEN=
# No Usul token yet? Set this to run anyway. Usul searches will fail, so the
# numbers come out lower than production, and the report warns about it.
# ALLOW_MISSING_USUL=true

# --- Prices, US dollars per 1 million tokens (cost.feature) ---
# Thinking tokens are billed as output tokens.
GEMINI_INPUT_USD_PER_MTOK=
GEMINI_OUTPUT_USD_PER_MTOK=
