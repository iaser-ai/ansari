{
  "name": "ansari-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "backend": "pnpm --filter ansari-backend",
    "frontend": "pnpm --filter ansari-frontend",
    "dev": "pnpm --filter ansari-backend dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter ansari-backend test",
    "build": "pnpm --filter ansari-backend build"
  }
}
