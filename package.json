{
  "name": "ansari-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "api": "pnpm --filter ansari-api",
    "frontend": "pnpm --filter ansari-frontend",
    "auth": "pnpm --filter ansari-auth",
    "prototype": "cd prototypes/ansari-expo && pnpm install --ignore-workspace && pnpm start",
    "dev": "turbo run dev --ui=tui --filter=!ansari-auth",
    "dev:auth": "pnpm --filter ansari-auth dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --",
    "test:coverage": "turbo run test:coverage --",
    "build": "turbo run build"
  },
  "devDependencies": {
    "turbo": "2.10.11"
  }
}
