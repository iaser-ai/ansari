{
  "name": "@ansari/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Better Auth configuration, Drizzle schema, and db client for the Ansari monorepo. Self-contained, additive (issue #59).",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./env": "./src/env.ts",
    "./db": "./src/db.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@ansari/types": "workspace:*",
    "@better-auth/expo": "1.7.7",
    "bcrypt": "^6.0.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.1",
    "resend": "^6.9.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@ansari/eslint-config": "workspace:*",
    "@ansari/tsconfig": "workspace:*",
    "@electric-sql/pglite": "^0.5.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.0.10",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "^4.1.11"
  }
}
