# Env contract for @ansari/auth (validated by src/env.ts).
# Copy to .env for local `drizzle-kit generate`/`migrate`. No real values here.

# Postgres connection string. Shares the physical database with apps/api, but
# Better Auth only ever touches its own NEW tables (user/session/account/verification).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ansari_auth_dev

# Better Auth signing secret. MUST be at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-plus-character-random-secret

# Public base URL of the apps/auth service (used for cookies + callback URLs).
BETTER_AUTH_URL=http://localhost:3100

# Allowed browser origin for CORS + trustedOrigins.
CORS_ORIGIN=http://localhost:3100
