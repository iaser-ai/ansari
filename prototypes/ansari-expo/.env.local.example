# Copy this file to `.env.local` (which is gitignored) to override the API base URL.
# You usually DON'T need to: the prototype defaults to the deployed staging
# backend, so a fresh checkout boots and works without any `.env.local`.
#
# app/_layout.tsx resolves the base URL as:  EXPO_PUBLIC_API_URL || <staging>
# Set a FULL URL, scheme included (https:// or http://), with NO trailing slash.
#
# EXPO_PUBLIC_* vars are inlined at bundle time: restart `expo start` after editing.
#
# Examples:
#   EXPO_PUBLIC_API_URL=https://api-staging.askansari.ai   # the default
#   EXPO_PUBLIC_API_URL=https://your-tunnel.ngrok.dev      # a personal tunnel

EXPO_PUBLIC_API_URL=https://api-staging.askansari.ai
