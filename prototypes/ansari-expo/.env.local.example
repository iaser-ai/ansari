# Copy this file to `.env.local` (which is gitignored) to run the prototype
# standalone against a live backend. See README section 1,
# "Running with a live backend (full functionality)".
#
# app/_layout.tsx builds the API base URL as:  `https://${EXPO_PUBLIC_DOMAIN}`
# so set the HOST ONLY, with NO scheme and NO trailing slash.
#
# The scheme is hardcoded to https:// — a plain http://localhost backend will
# NOT work without a one-line patch to app/_layout.tsx. An already-https dev
# domain (Replit / ngrok tunnel) works unpatched.
#
# EXPO_PUBLIC_* vars are inlined at bundle time: restart `expo start` after editing.

EXPO_PUBLIC_DOMAIN=your-backend-host.example.dev
