# Copy this file to `.env.local` (gitignored) to point the app at a
# different backend.
#
# `EXPO_PUBLIC_API_URL` is the API base URL. `app/_layout.tsx` calls
# `setBaseUrl(resolveBaseUrl())` and `resolveBaseUrl()` (lib/api/config.ts)
# reads this variable, defaulting to the deployed staging backend
# (`https://api-staging.askansari.ai`) when it is unset — so a fresh checkout
# runs against staging with no `.env.local` at all. Set it to a personal
# tunnel or a local `apps/api` when you need one.
#
# `EXPO_PUBLIC_AUTH_URL` is apps/auth's base URL, where the app signs in, signs
# up and signs out (`resolveAuthUrl()`, lib/api/config.ts). It defaults to the
# SAME environment as the API (`https://auth-staging.askansari.ai`). Change the
# two together: a session from one environment's apps/auth mints JWTs that
# another environment's apps/api refuses. For local services:
#   EXPO_PUBLIC_API_URL=http://localhost:3000
#   EXPO_PUBLIC_AUTH_URL=http://localhost:3100
#
# EXPO_PUBLIC_* vars are inlined at bundle time: restart `expo start` after
# editing.

EXPO_PUBLIC_API_URL=https://api-staging.askansari.ai
EXPO_PUBLIC_AUTH_URL=https://auth-staging.askansari.ai
