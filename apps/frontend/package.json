{
  "//": "build:web KEEPS its `pnpm run gen:types &&` chain deliberately. apps/frontend/Dockerfile.web installs with --filter ansari-frontend (which does not install root devDependencies, so turbo is absent from that image) and invokes build:web DIRECTLY. Without the chain, expo export runs with no uniwind-types.d.ts and the image build breaks. turbo.json also declares gen:types as a dependsOn edge of `build`, so under the graph the codegen has already run by the time this chain fires. This in-script call then runs uniwind a SECOND time — it does NOT become a Turbo cache hit, because `pnpm run` bypasses Turbo entirely. That duplicate is accepted deliberately: uniwind codegen is idempotent and takes well under a second, and the chain is what keeps the Docker path working. See turbo.json.",
  "name": "ansari-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "build": "pnpm run build:web",
    "build:web": "pnpm run gen:types && expo export --platform web",
    "build:icons": "node --no-warnings scripts/build-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:types": "uniwind generate-artifacts --css ./src/global.css --dts ./uniwind-types.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/literata": "^0.4.3",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.104.1",
    "@ungap/structured-clone": "^1.3.3",
    "expo": "~57.0.27",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-navigation-bar": "~57.0.3",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.2",
    "uniwind": "^1.12.2",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.5.4"
  },
  "devDependencies": {
    "@ansari/eslint-config": "workspace:*",
    "@ansari/tsconfig": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.2.15",
    "@types/react-dom": "^19.2.4",
    "babel-preset-expo": "^57.0.14",
    "eslint": "catalog:",
    "eslint-config-expo": "^57.0.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.3",
    "sharp": "^0.35.5",
    "typescript": "catalog:",
    "vitest": "^5.0.5"
  }
}
