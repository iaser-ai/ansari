{
  "name": "ansari-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "pnpm run gen:types && expo export --platform web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:types": "uniwind generate-artifacts --css ./src/global.css --dts ./uniwind-types.d.ts",
    "typecheck": "pnpm run gen:types && tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@gorhom/bottom-sheet": "^5.2.14",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.2",
    "expo-dev-client": "~57.0.10",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.2",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.12",
    "heroui-native": "^1.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "uniwind": "^1.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.15",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^57.0.0",
    "prettier": "^3.8.3",
    "typescript": "catalog:"
  }
}
