# Web build of the Expo app (react-native-web), served as a static SPA.
# Build context is the REPO ROOT (pnpm workspace needs the root lockfile):
#   docker build -f apps/frontend/Dockerfile.web .

# --- Build stage ---
FROM node:22-alpine AS builder

# packageManager in the root package.json pins the exact pnpm version.
RUN corepack enable

WORKDIR /repo

# EXPO_PUBLIC_* values are baked into the JS bundle at export time.
# Railway service variables arrive here as build args. EXPO_PUBLIC_API_URL and
# EXPO_PUBLIC_AUTH_URL are the app's ENTIRE env surface (lib/api/config.ts).
# BOTH ARE REQUIRED, in every environment (#317): the staging defaults in
# lib/api/config.ts are for local `expo start`/`expo export` only, and an image
# must never fall back to them. The guard below fails the build, naming the
# variable, when either is unset or empty, and refuses a pair that puts
# production api with non-production auth (or the reverse). It runs first, on
# plain Node, so a misconfigured service fails in seconds, before the install.
ARG EXPO_PUBLIC_API_URL
ARG EXPO_PUBLIC_AUTH_URL
# A declared ARG is visible as an env var to RUN steps in this stage, so the
# args above reach the guard and the export below without re-exporting via ENV.
COPY apps/frontend/scripts/check-web-env.mjs /tmp/check-web-env.mjs
RUN node /tmp/check-web-env.mjs

# Workspace manifests first so the dependency layer caches independently
# of source changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/frontend/package.json apps/frontend/
# See apps/api/Dockerfile: the shared workspace packages are needed before
# install (workspace:* link) and their contents are needed at build time
# (tsconfig extends the shared base).
COPY packages packages
RUN pnpm install --frozen-lockfile --filter ansari-frontend

COPY apps/frontend apps/frontend

ENV EXPO_NO_TELEMETRY=1

RUN pnpm --filter ansari-frontend run build:web

# --- Serve stage ---
FROM caddy:2-alpine

COPY apps/frontend/Caddyfile /etc/caddy/Caddyfile
COPY --from=builder /repo/apps/frontend/dist /usr/share/caddy

# Railway provides PORT; the Caddyfile falls back to 8080 locally.
EXPOSE 8080

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
