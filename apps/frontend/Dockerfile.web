# Web build of the Expo app (react-native-web), served as a static SPA.
# Build context is the REPO ROOT (pnpm workspace needs the root lockfile):
#   docker build -f apps/frontend/Dockerfile.web .

# --- Build stage ---
FROM node:22-alpine AS builder

# packageManager in the root package.json pins the exact pnpm version.
RUN corepack enable

WORKDIR /repo

# Workspace manifests first so the dependency layer caches independently
# of source changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/frontend/package.json apps/frontend/
RUN pnpm install --frozen-lockfile --filter ansari-frontend

COPY apps/frontend apps/frontend

# EXPO_PUBLIC_* values are baked into the JS bundle at export time.
# Railway service variables arrive here as build args.
ARG EXPO_PUBLIC_API_V2_URL
ARG EXPO_PUBLIC_API_TIMEOUT
ARG EXPO_PUBLIC_ENVIRONMENT
ARG EXPO_PUBLIC_SENTRY_DSN
ARG EXPO_PUBLIC_SUBSCRIBE_URL
ARG EXPO_PUBLIC_FEEDBACK_EMAIL
ARG EXPO_PUBLIC_COMPREHENSIVE_GUIDE_URL
ARG EXPO_PUBLIC_PRIVACY_URL
ARG EXPO_PUBLIC_TERMS_URL
ARG EXPO_PUBLIC_ENABLE_SHARE
ARG EXPO_PUBLIC_SHARE_URL
# A declared ARG is visible as an env var to RUN steps in this stage, so the
# args above reach the export below without re-exporting via ENV.
ENV EXPO_NO_TELEMETRY=1

RUN pnpm --filter ansari-frontend run build:web

# --- Serve stage ---
FROM caddy:2-alpine

COPY apps/frontend/Caddyfile /etc/caddy/Caddyfile
COPY --from=builder /repo/apps/frontend/dist /usr/share/caddy

# Railway provides PORT; the Caddyfile falls back to 8080 locally.
EXPOSE 8080

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
