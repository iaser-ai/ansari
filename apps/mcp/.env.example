# apps/mcp environment. Full descriptions: apps/mcp/README.md (Environment).
# Staging values: RELEASE.md (mcp service).
#
# Leave a variable commented out to use its default. Do NOT uncomment one with an
# empty value: for MCP_ALLOWED_HOSTS and MCP_ALLOWED_ORIGINS, set-but-empty means
# "allow none", not "use the default".

# HTTP port. Default 3000. On Railway, set it explicitly (3000) so Railway does
# not assign its own, and make the domain's target port match.
PORT=3000

# Ansari API origin. Default https://api.askansari.ai (PRODUCTION).
# ANSARI_API_BASE_URL=https://api-staging.askansari.ai

# Optional upstream Authorization header. Never commit a value.
# ANSARI_API_AUTHORIZATION=

# Upstream client label. Default ansari-mcp.
# ANSARI_CLIENT=ansari-mcp-staging

# Comma-separated allowed Host names, without scheme. Default localhost,127.0.0.1.
# MCP_ALLOWED_HOSTS=mcp-staging.askansari.ai

# Comma-separated allowed browser Origin hostnames. Default: the allowed hosts.
# Requests without an Origin header always pass.
# MCP_ALLOWED_ORIGINS=

# json = final-answer-only responses; unset = SSE (supports progress updates).
# MCP_RESPONSE_MODE=json

# Optional release id shown in /health, logs and the served HTML. On Railway,
# leave unset: it falls back to RAILWAY_GIT_COMMIT_SHA.
# ANSARI_RELEASE=
