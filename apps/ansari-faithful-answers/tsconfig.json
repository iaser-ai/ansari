{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"],
    "strict": true, "skipLibCheck": false, "noEmit": true,
    "allowImportingTsExtensions": true, "jsx": "react-jsx"
  },
  "include": ["src", "assets/*.ts", "scripts/*.ts", "test", "playwright.config.ts"]
}
