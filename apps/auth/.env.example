# Local env for the apps/auth service. Copy to .env. No real values here.
# Validated by @ansari/auth (packages/auth/src/env.ts); the startup error names
# any missing or invalid variable, never its value. tests/env-templates.test.ts
# fails if a variable the schema declares is missing here.

# The AUTH database (its own database, never the app's; CONTRIBUTING.md).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ansari_auth
BETTER_AUTH_SECRET=replace-with-a-32-plus-character-random-secret
BETTER_AUTH_URL=http://localhost:3100
# The apps/frontend WEB origins allowed to call this service (comma list).
# Expo web (Metro) in development is http://localhost:8081.
CORS_ORIGIN=http://localhost:8081
# apps/api's own origin: the Origin its /v2/users layer sends. trustedOrigins
# only, never a CORS origin. Same value as apps/api's AUTH_LAYER_ORIGIN.
AUTH_LAYER_ORIGIN=http://localhost:3000
NODE_ENV=development

# JWTs for apps/api: the issuer is this service's public URL; both must equal
# apps/api's AUTH_JWT_ISSUER and AUTH_JWT_AUDIENCE.
AUTH_JWT_ISSUER=http://localhost:3100
AUTH_JWT_AUDIENCE=ansari-api

# Reset emails (sent by this service; the link is ${FRONTEND_URL}/reset-password?token=…).
RESEND_API_KEY=re_placeholder_key_20_chars
FRONTEND_URL=http://localhost:8081

# Admins: no list here. The role in auth.users is the only truth; grant it with
# scripts/grant-admin.ts <email>, then --confirm <id>.
# Optional URLs. Leave them commented out when unused: an empty value is not
# "unset" and fails the URL check at boot.
# MARKETMAKER_URL=https://marketmaker.example/subscribe
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# The one listener. apps/api reaches it here too (its AUTH_URL).
PORT=3100
