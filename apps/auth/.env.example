# Local env for the apps/auth service. Copy to .env. No real values here.
# The auth config (@ansari/auth) validates these — see packages/auth/.env.example.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/ansari_auth_dev
BETTER_AUTH_SECRET=replace-with-a-32-plus-character-random-secret
BETTER_AUTH_URL=http://localhost:3100
CORS_ORIGIN=http://localhost:3100

# Port the Express service listens on (defaults to 3100 to avoid apps/api).
PORT=3100
