# Dummy, no-secrets env for CI (mirrors apps/api/.env.ci). Every value is fake.
# Loaded into the CI auth job so any code path that touches env has values.
DATABASE_URL=postgres://ci:ci@localhost:5432/ci_dummy
BETTER_AUTH_SECRET=ci-dummy-not-a-real-secret-000000000000
BETTER_AUTH_URL=http://localhost:3100
CORS_ORIGIN=http://localhost:3100
NODE_ENV=test
