# CI dummy environment for apps/auth — mirrors apps/api/.env.ci. Every value is
# deliberately, obviously fake; no repository secrets. CI loads this file:
#   grep -v '^#' apps/auth/.env.ci >> "$GITHUB_ENV"
# Not auto-loaded by any runtime (only .env / .env.local are). The suites set
# their own env per test (packages/auth/tests/helpers/auth-db.ts setAuthEnv);
# these values exist so every variable the service requires is present in CI
# (tests/env-templates.test.ts checks that).
DATABASE_URL=postgresql://placeholder-user:placeholder-not-a-real-password@localhost:5432/ansari_auth_ci
BETTER_AUTH_SECRET=placeholder-not-a-real-secret-just-32-plus-chars
BETTER_AUTH_URL=http://localhost:3100
CORS_ORIGIN=http://localhost:8081
AUTH_LAYER_ORIGIN=http://localhost:3000
AUTH_JWT_ISSUER=http://localhost:3100
AUTH_JWT_AUDIENCE=ansari-api
RESEND_API_KEY=re_placeholder-not-a-real-key
FRONTEND_URL=http://localhost:8081
PORT=3100
NODE_ENV=test
