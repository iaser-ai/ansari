{
  "$comment": "Frozen wire contract of the legacy /v2/users/* surface and the two password-reset routes, pinned against the pre-migration apps/api (spec 300, plan phase 1). `shape` is the EXACT key set with each value's type (string | null | uuid | iso-datetime). `values` pins literal values. `detailOneOf` is used ONLY where the post-migration backend cannot recover today's distinct cause (a refresh 401 from apps/auth, or an opaque non-JWT bearer): the status and the set are frozen, the specific member is not. Every other detail is exact. Phase 8 must pass against these files unedited.",

  "register.ok": {
    "status": 200,
    "shape": { "status": "string", "access_token": "string", "refresh_token": "string", "token_type": "string" },
    "values": { "status": "success", "token_type": "bearer" }
  },
  "register.invalid_email": {
    "status": 422,
    "shape": { "detail": "string" },
    "values": { "detail": "Invalid email format" }
  },
  "register.password_too_short": {
    "status": 422,
    "shape": { "detail": "string" },
    "values": { "detail": "Password must be at least 8 characters" }
  },
  "register.password_too_long": {
    "status": 422,
    "shape": { "detail": "string" },
    "values": { "detail": "Password must be at most 128 characters" }
  },
  "register.invalid_email_and_short_password": {
    "status": 422,
    "shape": { "detail": "string" },
    "values": { "detail": "Invalid email format, Password must be at least 8 characters" }
  },
  "register.missing_fields": {
    "status": 422,
    "shape": { "detail": "string" },
    "values": { "detail": "Invalid input: expected string, received undefined, Invalid input: expected string, received undefined" }
  },
  "register.email_taken": {
    "status": 409,
    "shape": { "detail": "string" },
    "values": { "detail": "An account with this email already exists" }
  },
  "register.weak_password": {
    "status": 400,
    "shape": { "detail": "string" },
    "values": { "detail": "Password is too weak. Add uppercase letters Add numbers Add special characters" }
  },
  "register.malformed_json": {
    "status": 500,
    "shape": { "detail": "string" },
    "values": { "detail": "Registration failed" }
  },

