      "refresh_token": "string",
      "token_type": "string",
      "first_name": "string",
      "last_name": "string"
    },
    "values": { "status": "success", "token_type": "bearer", "first_name": "", "last_name": "" }
  },
  "login.invalid_credentials": {
    "status": 401,
    "shape": { "detail": "string" },
