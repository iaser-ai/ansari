    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "eslint-config-next": "^15.5.22",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
