    "@sentry/nextjs": "^10.39.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.9",
    "next": "^15.5.25",
    "pg": "^8.17.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@ansari/eslint-config": "workspace:*",
    "@ansari/tsconfig": "workspace:*",
    "@electric-sql/pglite": "^0.5.3",
