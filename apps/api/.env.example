# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ansari_backend

# Auth
JWT_SECRET=your-secret-key-at-least-32-characters-long
ACCESS_TOKEN_EXPIRY_HOURS=2
REFRESH_TOKEN_EXPIRY_HOURS=2160

# AI - Facilitator (Gemini)
# Configure ONE of the two paths below. If GOOGLE_CLOUD_PROJECT is set, Vertex AI is used.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
# Separate-pool Vertex model used ONLY by the mid-call 429 fast-failover (#45);
# not part of the empty-final retry ladder (#79 escalates to Inkling instead).
GEMINI_FALLBACK_MODEL=gemini-3.1-pro-preview

# AI - Facilitator (Vertex AI) — preferred when set
# Local dev: point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON file.
# Railway / serverless: paste the JSON contents into GOOGLE_APPLICATION_CREDENTIALS_JSON instead.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-credentials.json
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# AI - Inkling off-Vertex backup (issues #74/#79)
# Optional. Enables the second rung of the empty-final retry ladder AND the
# one-shot rescue for terminal Gemini errors (thinkingmachines/Inkling via the
# Tinker OpenAI-compat endpoint). When unset, both are skipped cleanly.
TINKER_API_KEY=your-tinker-api-key
# Optional overrides (issue #90): which Inkling model to request (e.g. a
# fine-tuned LoRA via a tinker://... sampler-weights id), its completion cap,
# and the per-call timeout. INKLING_MAX_TOKENS must sit in the 8192-32768
# window — it budgets thinking+answer, and below 8K the hidden reasoning pass
# starves the visible answer. INKLING_TIMEOUT_MS (30000-600000 window) is the
# default when a caller passes no timeout AND a cap on the facilitator's
# budget-derived Inkling call timeouts (min(remaining budget, this value)) —
# it can shorten calls, never lengthen them past the request budget. Defaults
# shown.
# INKLING_MODEL=thinkingmachines/Inkling
# INKLING_MAX_TOKENS=8192
# INKLING_TIMEOUT_MS=180000

# AI - Primary backend switch (issue #95) — EXPERIMENTATION ONLY.
# PRIMARY_BACKEND=inkling routes EVERY facilitator primary call through the
# OpenAI-compatible client instead of Gemini (benchmark/eval runs, exported
# LoRAs, Gemini-outage escape hatch). NOT a supported production configuration.
# Default 'gemini' is byte-identical to not setting anything.
# PRIMARY_BACKEND=gemini
# Full /chat/completions URL of any OpenAI-compatible endpoint (https required;
# plain http allowed only for localhost/127.*). Default: the Tinker prod URL
# used by the fallback rungs.
# INKLING_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1/chat/completions
# Bearer token for INKLING_BASE_URL; falls back to TINKER_API_KEY when unset.
# INKLING_API_KEY=your-inkling-api-key


# Islamic Tools
# NOTE: these keys are not self-serve — request them from the respective providers
# (Kalemat for Quran/Hadith search, Usul for Mawsuah/Tafsir vector search).
KALEMAT_API_KEY=your-kalemat-api-key
USUL_API_TOKEN=your-usul-api-token
USUL_BASE_URL=https://api.usul.ai/v1/vector-search

# Admin
# Comma-separated list of emails allowed to access the admin dashboard. Optional.
ADMIN_EMAILS=

# Email (Password Reset)
RESEND_API_KEY=re_...
FRONTEND_URL=https://askansari.ai

# Newsletter (optional). When unset, newsletter subscriptions are skipped entirely
# (logged once at first attempt). Set to your newsletter service's subscribe endpoint.
# MARKETMAKER_URL=https://your-newsletter-service.example.com/api/newsletter/subscribe

# Sentry
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=sntrys_...  # Optional — for source map uploads in production builds
# RAILWAY_ENVIRONMENT is auto-injected by Railway and used as the Sentry environment tag.
# Optional — falls back to NODE_ENV off-Railway; no need to set it manually.
# RAILWAY_ENVIRONMENT=production

# IslamicMMLU leaderboard bearer token for /api/v1/chat/completions (Spec 19).
# Optional — when unset the OpenAI-compat endpoint returns 503. Generate with `openssl rand -hex 32`.
LEADERBOARD_API_KEY=

# App version control (served by /api/v2/app-check). All optional with defaults.
MAINTENANCE_MODE=false
IOS_MINIMUM_BUILD_VERSION=1
IOS_LATEST_BUILD_VERSION=1
ANDROID_MINIMUM_BUILD_VERSION=1
ANDROID_LATEST_BUILD_VERSION=1

# Environment
NODE_ENV=development
