{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The spec 300 auth suites (tests/auth/) boot the real apps/auth in
    // process, over a pglite database built from packages/auth's journal, and
    // reuse both packages' test helpers. None of that is in this package's
    // task hash by default (globalDependencies carries packages/auth/src only),
    // so without these inputs a warm cache would replay apps/api's tests after
    // apps/auth, its schema or the helpers changed.
    //
    // The doc and scan suites read files outside this package too: the
    // runbooks and docs (release-doc, self-hosting-docs, contributor-docs,
    // cutover-docs), the .github and gitleaks files contributor-docs checks, and
    // apps/auth/scripts (the source scans; the cutover scripts the runbook
    // names). Without them a doc edit left ansari-api#test at the same hash
    // (verified) and a warm cache replayed a stale doc test.
    //
    // The root package.json is here for root-test-script.test.ts (issue #330),
    // which pins the root `test` script's worker cap: without it, removing the
    // cap left this task at the same hash and a warm cache replayed the pin green.
    //
    // Every app's src/ and lib/ and every package are here for source-scan 6
    // (#314, widened by #377), which reads them for RAILWAY_* names: without
    // them a RAILWAY_ read added there left this task at the same hash and a
    // warm cache replayed the scan green. (apps/auth/scripts, also scanned, is
    // listed above.)
    //
    // The railway tomls are here for release-doc.test.ts (issue #364), which
    // checks each one against RELEASE.md: without them a toml-only edit left this
    // task at the same hash and a warm cache replayed the check green.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.ci",
        "$TURBO_ROOT$/apps/auth/scripts/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/apps/*/lib/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/apps/auth/tests/helpers/**",
        "$TURBO_ROOT$/packages/auth/drizzle/**",
        "$TURBO_ROOT$/packages/auth/tests/helpers/**",
        "$TURBO_ROOT$/RELEASE.md",
        "$TURBO_ROOT$/CONTRIBUTING.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/.github/ISSUE_TEMPLATE/**",
        "$TURBO_ROOT$/.github/scripts/**",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/.gitleaksignore",
        "$TURBO_ROOT$/.gitleaks.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/*/railway.toml",
        "$TURBO_ROOT$/legacy/*/railway.toml"
      ]
    },

    // CI runs this task, not `test`, so it lists EXACTLY the same inputs:
    // overriding `inputs` replaces the root task's list, and turbo cannot share
    // one between tasks, so the list is repeated. Every entry `test` has and
    // this lacked left ansari-api#test:coverage at the same hash when only that
    // file changed, and a warm cache replayed a stale doc or scan result (#381;
    // patched one entry at a time before by #330, #314, #377).
    // tests/turbo-coverage-inputs.test.ts fails if the two lists differ.
    "test:coverage": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.ci",
        "$TURBO_ROOT$/apps/auth/scripts/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/apps/*/lib/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/apps/auth/tests/helpers/**",
        "$TURBO_ROOT$/packages/auth/drizzle/**",
        "$TURBO_ROOT$/packages/auth/tests/helpers/**",
        "$TURBO_ROOT$/RELEASE.md",
        "$TURBO_ROOT$/CONTRIBUTING.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/.github/ISSUE_TEMPLATE/**",
        "$TURBO_ROOT$/.github/scripts/**",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/.gitleaksignore",
        "$TURBO_ROOT$/.gitleaks.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/*/railway.toml",
        "$TURBO_ROOT$/legacy/*/railway.toml"
      ]
    }
  }
}
