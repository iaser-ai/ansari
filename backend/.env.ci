# CI dummy environment — the single reproducible no-secrets env source.
# Every value is deliberately, obviously fake. CI loads this file; local
# verification uses it the same way:
#   env $(grep -v '^#' .env.ci | xargs) npm test
# Not auto-loaded by Next.js or Vitest (only .env / .env.local / .env.<mode> are).
DATABASE_URL=postgresql://placeholder-user:placeholder-not-a-real-password@localhost:5432/ansari_backend_ci
JWT_SECRET=placeholder-not-a-real-secret-just-32-plus-chars
KALEMAT_API_KEY=placeholder-not-a-real-key
USUL_API_TOKEN=placeholder-not-a-real-token
GEMINI_API_KEY=placeholder-not-a-real-key
