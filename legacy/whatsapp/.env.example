# Where ansari-whatsapp is currently deployed
#   (local (i.e., local), development, staging, production)
# NOTE: local type will add localhost to ORIGINS, etc.
DEPLOYMENT_TYPE="local"

# Sentry DSN for error tracking and monitoring
# To obtain the Sentry DSN:
# 1. Log in to your Sentry account at https://sentry.io
# 2. Select your organization and project
# 3. Go to Settings > Projects > [Your Project Name] > Client Keys (DSN)
# 4. Copy the DSN value (it should look like: https://xxxxx@xxxxx.ingest.sentry.io/xxxxx)
# Leave empty or omit to disable Sentry error tracking
SENTRY_DSN=""

###################################### Related to apps/api and apps/auth ######################################
# apps/api's base URL (WITHOUT any path). The client appends /api/v2/* to it.
# if local: "http://localhost:3000"
BACKEND_SERVER_URL="http://localhost:3000"

# apps/auth's base URL (WITHOUT any path). The auth client appends /api/whatsapp/session to it.
# if local: "http://localhost:3100"
AUTH_SERVER_URL="http://localhost:3100"

# API key that authenticates this service to apps/auth's /whatsapp endpoint.
# Sent as `Authorization: Bearer <key>` (issue #329). MUST be a key issued by apps/auth for this service.
AUTH_WHATSAPP_API_KEY="your_generated_secret_key_here"

###################################### Related to CORS ######################################

# CORS settings - URLs that are allowed to access ansari-whatsapp
ORIGINS="https://api.ansari.chat,https://web.whatsapp.com"
# Explained in WhatsApp comments below
META_WEBHOOK_ZROK_SHARE_TOKEN="<<THE-ZROK-SHARE-TOKEN-CURRENTLY-USED-IN-META'S-CALLBACK-URL>>"

###################################### Related to WhatsApp Business and Meta ######################################

# Preface: You might be asking yourself: "ALL OF THESE CONFIGS JUST TO SETUP WHATSAPP?!"
#       And the answer is yes :'D ... Meta's API/setup-processes are a bit complicated... but that's why BSPs exist.
#       Read this for more details:
#       https://www.reddit.com/r/WhatsappBusinessAPI/comments/1mwa0r6/difference_between_using_meta_whatsapp_cloud_api/
#       However, we decided to do it the old-fashioned way; Straight to the main API 8)

# Source 0: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Source 1: https://www.youtube.com/watch?v=KP6_BUw3i0U
#   Watch Until 32:25, while quickly skimming through the non-python code parts
# Source 2 (mentioned in video above): https://glitch.com/edit/#!/insidious-tartan-alvarezsaurus
#           (the `verification_webhook` endpoint in `main.py` is inspired by the above URL)
# Source 3 (optional): https://developers.facebook.com/blog/post/2022/10/24/sending-messages-with-whatsapp-in-your-python-applications/#u_0_39_8q

# Moreover, if want to test whatsapp's webhook locally, you can use zrok on a reserved URL with a zrok "share token"
# obtained by contacting its current holder: https://github.com/OdyAsh (source 1, 2 below)
# Alternatively, you can change the webhook url all together (source 3, 4 below)
# Check these sources for more details:
# Source 1: https://dev.to/odyash/quickly-share-your-app-with-zrok-4ihp
# Source 2: https://openziti.discourse.group/t/how-do-i-use-a-reserved-share-on-different-devices/2379/2
# Source 3: https://youtu.be/KP6_BUw3i0U?t=1294
#   (@21:33 and 25:30, however they use glitch instead of zrok, so the video here is just to give you an idea how to setup a webhook)
# Source 4 (where you can change callback url, given that your facebook account gets access by the app's admins):
#   https://developers.facebook.com/apps/871020755148175/whatsapp-business/wa-settings/
#   NOTE 1: Obviously, that `871020755148175` in the above URL is the testing app's public id, so if this link still doesn't work even after you gain access,
#   then the admins most probably created a new test app instance
#   NOTE 2: When you see the `Callback URL`, it will be something like "https://META_WEBHOOK_ZROK_SHARE_TOKEN.share.zrok.io/whatsapp/v2"
#           (The `/whatsapp/v2` endpoint can be found in `main.py`'s endpoints, that's why it's in the url above)
#           Moreover, this zrok callback URL is only used for `Ansari Test` app on developers.facebook.com,
#           so we should only use it while locally developing this repo, not in staging/prod/etc. environments
#   NOTE 3: If an unexpected 3rd party discovers the META_WEBHOOK_ZROK_SHARE_TOKEN,
#   a new one will have to be generated, then added to Meta's callback URL of the *testing* app
#   (Noting that the *production* app's callback URL will be different anyway, so the 3rd party won't be able to access that app)
#   (but we still don't want random calls to be made to our testing app, so that's why we'll still have to change an exposed token :])
#       Side note: the current zrok instance (i.e., "https://META_WEBHOOK_ZROK_SHARE_TOKEN.share.zrok.io")
#                   currently proxies (i.e., maps to) this local address: http://127.0.0.1:8001
#                   Therefore, if for some reason, you want to change that address,
#                   then you'll need to re-establish the mapping by doing these 2 commands:
#                   `zrok release <<META_WEBHOOK_ZROK_SHARE_TOKEN>>`
#                   `zrok reserve public XXXX --unique-name "<<META_WEBHOOK_ZROK_SHARE_TOKEN>>"`
#                   where XXXX is your new port number (which correspond to the PORT variable found in `.env` file)

META_API_VERSION="v22.0"


# Phone number ID (from Meta Dashboard)
# NOTE 1: Contact the team to see whatsapp's 2 phone nums -> one for prod. env. and the other for local/stage testing
# NOTE 2: If you encounter this error: 
#   "Client error '400 Bad Request' for url 'https://graph.facebook.com/v22.0/<META_BUSINESS_PHONE_NUMBER_ID>/messages'"
#   then either:
#       (1) the <META_BUSINESS_PHONE_NUMBER_ID> got deleted by Meta due to inactive use for a long time.
#           If this happens, then open the page in source 3 (i.e., youtube video URL above) @6:11. 
#           Then, under "step 1" in the middle of the page, you'll see a selection box with the live WhatsApp number;
#           click on it, then click "Get new test number". Then, wait for a while, then you'll see the new number; 
#           Now copy its number id and paste it in <META_BUSINESS_PHONE_NUMBER_ID>
#       (2) Meta updated its version and so now <WHATSAPP_API_VERSION> is outdated.
#           You can verify this by opening source 3 @26:13 and checking the version associated with `messages`
#       (3) you sent a message with an incorrect format. Check source 3; 26:10->26:28, click on `messages` to see how it should be sent
META_BUSINESS_PHONE_NUMBER_ID="your_phone_number_id_here"

# System User Access Token (from Meta Dashboard)
# NOTE 1: check video in source 3 above from 30:45 to 32:15 to see where we get the access token
# NOTE 2: Contact the team to see their 3 access tokens -> one for prod. app (Ansari), one for staging app (Ansari - Staging), and one for local/dev. app (Ansari - Test)
# NOTE 3: If you want to debug or check the validity of an access token, check this URL:
#   https://developers.facebook.com/tools/debug/accesstoken/?access_token=<YOUR-ACCESS-TOKEN>
META_ACCESS_TOKEN_FROM_SYS_USER="your_access_token_here"

# Token for webhook verification (from Meta Dashboard)
META_WEBHOOK_VERIFY_TOKEN="<<The-VERIFIFY-TOKEN-CURRENTLY-USED-TO-VERIFY-META'S-CALLBACK-URL>>"

# Meta App Secret for webhook signature verification
# References:
# - https://developers.facebook.com/docs/graph-api/webhooks/getting-started#validate-payloads
# - https://developers.facebook.com/docs/facebook-login/security/
# - https://stackoverflow.com/questions/76898751/how-to-find-app-secret-for-whatsapp-business-api
# Location: Meta Developer Dashboard (https://developers.facebook.com/)
#   → Log in → My Apps → Select your app → App Settings → Basic → App Secret (click "Show")
# NOTE: In "Select your app" step, we mean one of the following: "Ansari - Test", "Ansari - Staging", "Ansari"
#   Where "Ansari - Test" is used for local development with zrok webhook URL
# Security: Used to verify X-Hub-Signature-256 header on incoming webhooks from Meta
# This ensures webhook requests are authentic and haven't been tampered with
META_ANSARI_APP_SECRET="your_app_secret_here"


###################################### Related to Chat Settings ######################################

# When True, every message gets a "down for maintenance" reply and is not processed.
# This is the WhatsApp service's own switch; it does NOT follow apps/api's MAINTENANCE_MODE.
WA_MAINTENANCE_MODE="False"
# Hours to retain chat history
WHATSAPP_CHAT_RETENTION_HOURS="3"
# Maximum age in seconds for incoming WhatsApp messages to be processed (24 hours = 86400 seconds)
# Messages older than this threshold will be rejected to avoid processing outdated messages
WHATSAPP_MESSAGE_AGE_THRESHOLD_SECONDS="86400"

###################################### Related to Test/Development/Logging ######################################

# Optional. Only needed for one manual check: "does Meta really accept a message sent to a BSUID?"
# A BSUID is Meta's per-user ID that replaces the phone number when a user hides it (looks like EG.1234567890123456789).
# You can't make one up; it has to belong to a real WhatsApp user who has already messaged OUR business number.
# How to get yours: message the business number from your own phone, then read the BSUID from a log line that
# prints the webhook's from_user_id. (The old ansari-whatsapp service doesn't log it unless a temporary line is added.)
# BSUIDs are per business portfolio, so yours only works with phone numbers owned by the same portfolio.
# Keep it private: never commit it, paste it in an issue or print it in logs.
# REAL_TEST_BSUID=""

# Meta webhook response behavior
# Meta's webhooks require HTTP 200 responses to acknowledge receipt.
# When True (production/staging/development/local): Always return HTTP 200 to Meta, regardless of internal errors
# When False (testing only): Return proper HTTP status codes (400, 500, etc.) for test assertions
# NOTE: This should ALWAYS be True in production. Only set to False in automated tests.
ALWAYS_RETURN_OK_TO_META="True"

# Optional. Leave unset for DEBUG when DEPLOYMENT_TYPE=local and INFO everywhere else.
# LOGGING_LEVEL="INFO"

# If True, only log messages from test files (i.e., files in "tests" folder or files starting with "test_")
#   Otherwise, log messages coming from any file
# (Mainly used when running test scripts)
LOG_TEST_FILES_ONLY="False"

###################################### Related to Service Provider Settings ######################################

# If True, use mock Ansari client instead of making real HTTP calls to the backend
# Mock mode is useful for:
#   - Development without requiring the backend service to be running
#   - Unit testing with simulated responses and realistic latency/errors
#   - Offline development and testing
#   - Cost savings (no AI API calls during development)
# When False (default), the real client makes actual HTTP requests to BACKEND_SERVER_URL
MOCK_ANSARI_CLIENT="False"

# If True, use a mock apps/auth client that issues fake tokens instead of calling apps/auth.
# Useful while apps/auth's /whatsapp endpoint is not available. When False (default), the real call is made.
MOCK_AUTH_CLIENT="False"

# Optional, only with MOCK_AUTH_CLIENT=True: a real apps/auth JWT that the mock returns for every BSUID,
# so a mocked sign-in can talk to a real apps/api. Get one by logging in through apps/api (POST /api/v2/users/login).
# Leave unset to get fake tokens (which a real apps/api rejects).
# Every user would share this one account and thread, so the service refuses to start with it
# unless DEPLOYMENT_TYPE="local".
# MOCK_AUTH_TOKEN=""

# If True, use mock Meta API service instead of making real HTTP calls to Meta WhatsApp API
# Mock mode is useful for:
#   - Development when Meta API credentials are not configured or invalid
#   - Testing webhook flow without sending actual WhatsApp messages
#   - Avoiding Meta API quota consumption during development
#   - Debugging issues without affecting real WhatsApp users
# When False (default), real HTTP calls are made to Meta WhatsApp Cloud API
MOCK_META_API="False"